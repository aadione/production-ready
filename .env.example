# Copy to .env (local) or add these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Browser (safe to expose, injected into the client bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (NEVER prefix these with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_PIN_SECRET=
